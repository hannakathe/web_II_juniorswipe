# Copia este archivo como .env para ejecutar en local. NUNCA subas el .env real.
SECRET_KEY=cambia-esta-clave
JWT_SECRET=cambia-esta-clave-tambien
JWT_EXPIRES_SECONDS=3600
 
# Vacío = usa un archivo SQLite local (no necesitas instalar PostgreSQL).
DATABASE_URL=
 
# Orígenes del navegador que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
 
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
SEED_ON_STARTUP=true
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
